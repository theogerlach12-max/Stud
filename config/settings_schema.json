[
  {
    "name": "theme_info",
    "theme_name": "Stud",
    "theme_version": "2.0.0",
    "theme_author": "Stud",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "paragraph",
        "content": "The STUD wordmark artwork ships in assets/logo-stud.png. It is black with a transparent background, and it is flipped to white automatically on dark backgrounds."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image (overrides the bundled wordmark)"
      },
      {
        "type": "text",
        "id": "logo_asset",
        "label": "Bundled logo filename",
        "default": "logo-stud.png",
        "info": "A file in assets/. Used when no logo is picked above. Clear both to fall back to text."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "label": "Logo width",
        "default": 108
      },
      {
        "type": "text",
        "id": "wordmark",
        "label": "Wordmark text (fallback only)",
        "default": "Stud",
        "info": "Used only if there is no logo image at all."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Stud is a black and white brand. Changing these away from black/white will break the look."
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_background_alt",
        "label": "Background (alternate section)",
        "default": "#F4F4F4"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#6E6E6E"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border / hairline",
        "default": "#E0E0E0"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Button background",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale price",
        "default": "#000000"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "checkbox",
        "id": "use_grotesque_display",
        "label": "Use Helvetica-style display type",
        "default": true,
        "info": "On: the wordmark and all landing-page headlines use a neo-grotesque stack (Helvetica Neue / Inter / Arial), matching the Haus wordmark look. Off: they use the heading font below."
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading font",
        "default": "assistant_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1280
      }
    ]
  },
  {
    "name": "Announcement bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Show announcement bar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_countdown",
        "label": "Show countdown timer",
        "default": false,
        "info": "Only turn this on for a real, dated deadline. The timer rolls over to a fresh 48 hours once the date passes, which is a fake-urgency pattern if the deadline is not real."
      },
      {
        "type": "text",
        "id": "countdown_end",
        "label": "Countdown end date (YYYY-MM-DD HH:MM)",
        "default": ""
      }
    ]
  },
  {
    "name": "Buy bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_sticky_buy",
        "label": "Show sticky buy bar after the hero",
        "default": true
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart behavior",
        "options": [
          { "value": "drawer", "label": "Drawer (slide-out)" },
          { "value": "page", "label": "Dedicated page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_free_shipping",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "number",
        "id": "cart_free_shipping_threshold",
        "label": "Free shipping threshold ($)",
        "default": 50
      }
    ]
  }
]
