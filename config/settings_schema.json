[
  {
    "name": "theme_info",
    "theme_name": "Stud",
    "theme_version": "1.0.0",
    "theme_author": "Stud",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 260,
        "step": 5,
        "unit": "px",
        "label": "Logo width",
        "default": 130
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#F7F3EC"
      },
      {
        "type": "color",
        "id": "color_background_alt",
        "label": "Background (alternate section)",
        "default": "#EFE8DA"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#211D18"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#7A7263"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (gold)",
        "default": "#B08D4C"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#DDD3BF"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Button background",
        "default": "#211D18"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#F7F3EC"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale price / badge",
        "default": "#A23B2E"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading font",
        "default": "playfair-display_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1280
      }
    ]
  },
  {
    "name": "Announcement bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Show announcement bar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_countdown",
        "label": "Show countdown timer",
        "default": true
      },
      {
        "type": "text",
        "id": "countdown_end",
        "label": "Countdown end date (YYYY-MM-DD HH:MM)",
        "info": "Timer resets to 48 hours from now if this date has already passed.",
        "default": "2026-12-31 23:59"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart behavior",
        "options": [
          { "value": "drawer", "label": "Drawer (slide-out)" },
          { "value": "page", "label": "Dedicated page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_free_shipping",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "number",
        "id": "cart_free_shipping_threshold",
        "label": "Free shipping threshold ($)",
        "default": 50
      }
    ]
  }
]
