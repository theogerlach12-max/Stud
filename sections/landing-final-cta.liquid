{%- liquid
  assign product = section.settings.product
  assign price_text = section.settings.price_text
  if product != blank and section.settings.use_product_price
    assign price_text = product.price | money
  endif
-%}

<section class="landing-section landing-section--invert final-cta">
  {%- if section.settings.image != blank -%}
    <div class="final-cta__media">
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        alt="{{ section.settings.image.alt | escape }}"
        loading="lazy"
      >
      <div class="final-cta__scrim"></div>
    </div>
  {%- elsif section.settings.image_asset != blank -%}
    <div class="final-cta__media">
      <img src="{{ section.settings.image_asset | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy">
      <div class="final-cta__scrim"></div>
    </div>
  {%- endif -%}

  <div class="page-width final-cta__content" data-reveal>
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h2 class="display final-cta__heading">{{ section.settings.heading }}</h2>

    {%- if section.settings.text != blank -%}
      <p class="final-cta__text">{{ section.settings.text }}</p>
    {%- endif -%}

    <div class="final-cta__actions">
      <a href="{{ section.settings.button_link | default: '#signup' }}" class="button button--invert button--large">
        {{ section.settings.button_label }}
      </a>
      {%- if price_text != blank -%}
        <span class="final-cta__price">{{ price_text }}</span>
      {%- endif -%}
    </div>

    {%- if section.settings.urgency != blank -%}
      <p class="final-cta__urgency">{{ section.settings.urgency }}</p>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="final-cta__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (optional)"
    },
    { "type": "text", "id": "image_asset", "label": "Bundled image filename", "info": "A file in assets/. Used when no image is picked above.", "default": "athlete-vest.png" },
    { "type": "text", "id": "image_alt", "label": "Bundled image alt text", "default": "Man in a tactical vest wearing a stud, waterfront at dusk" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Last thing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Look good. Feel good. Play good."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Three sizes, one kit, no holes in your ear. Find your fit tonight."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get your kit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "use_product_price",
      "label": "Use the live Shopify price",
      "default": true
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price text (fallback)",
      "default": "$39"
    },
    {
      "type": "header",
      "content": "Urgency"
    },
    {
      "type": "text",
      "id": "urgency",
      "label": "Urgency line",
      "info": "Leave empty unless it is true. Launch pricing, a real stock number, a real end date — nothing invented.",
      "default": ""
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Free shipping · 30-day returns"
    }
  ],
  "presets": [
    { "name": "Final CTA" }
  ]
}
{% endschema %}
