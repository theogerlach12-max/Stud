<section class="hero" style="{% if section.settings.image != blank %}--hero-image: url('{{ section.settings.image | image_url: width: 2000 }}');{% endif %}">
  <div class="hero__overlay"></div>
  <div class="page-width hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button button--primary hero__button">{{ section.settings.button_label }}</a>
    {%- endif -%}
    {%- if section.settings.show_rating -%}
      <p class="hero__rating">
        {%- for i in (1..5) -%}{% render 'icon-star', filled: true %}{%- endfor -%}
        <span>{{ section.settings.rating_text }}</span>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "MAGNETIC. NO PIERCING NEEDED."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Earrings that stay on your terms"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Studio-grade magnetic hold, zero piercing required. Buy 2, get 1 free."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop best sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating line",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Trusted by 12,000+ customers"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
