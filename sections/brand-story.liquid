<section class="brand-story">
  <div class="page-width brand-story__inner">
    <div class="brand-story__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="450" height="560">
      {%- else -%}
        <div class="brand-story__placeholder"></div>
      {%- endif -%}
    </div>
    <div class="brand-story__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
      <div class="brand-story__text rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--secondary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY MAGNETIC"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All the style. None of the piercing."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every Stud pair is built around a set of medical-grade magnets strong enough to hold through a full day, gentle enough for sensitive ears. Swap them in seconds — no holes, no scar tissue, no commitment.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
