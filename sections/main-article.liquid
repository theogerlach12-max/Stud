<div class="page-width article-page">
  <h1 class="section-heading">{{ article.title }}</h1>
  <p class="article-page__meta">{{ article.published_at | date: '%B %d, %Y' }}{% if article.author != blank %} &middot; {{ article.author }}{% endif %}</p>
  {%- if article.image -%}
    <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" width="800" height="450" class="article-page__image">
  {%- endif -%}
  <div class="rte article-page__content">{{ article.content }}</div>
</div>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
