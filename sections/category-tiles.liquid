<section class="category-tiles page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="category-tiles__grid">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <a href="{% if collection != blank %}{{ collection.url }}{% else %}{{ block.settings.link }}{% endif %}" class="category-tile" {{ block.shopify_attributes }}>
        <div class="category-tile__image">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.title }}" loading="lazy" width="240" height="240">
          {%- elsif collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ block.settings.title }}" loading="lazy" width="240" height="240">
          {%- else -%}
            <div class="category-tile__placeholder"></div>
          {%- endif -%}
        </div>
        <span class="category-tile__title">{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by style"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Studs"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (used if no collection selected)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (overrides collection image)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Studs" } },
        { "type": "tile", "settings": { "title": "Hoops" } },
        { "type": "tile", "settings": { "title": "Huggies" } },
        { "type": "tile", "settings": { "title": "Bundles" } },
        { "type": "tile", "settings": { "title": "Gifting" } }
      ]
    }
  ]
}
{% endschema %}
