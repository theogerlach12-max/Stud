<header class="site-header" data-header>
  <div class="site-header__inner page-width">

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          width="{{ settings.logo_width }}"
          height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio | default: settings.logo_width }}"
          loading="eager"
          style="width: {{ settings.logo_width }}px;"
        >
      {%- else -%}
        <span class="wordmark">{{ settings.wordmark | default: shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="site-header__end">
      {%- if section.settings.show_header_cta -%}
        <a href="{{ section.settings.cta_link | default: '#offer' }}" class="button button--primary button--small site-header__cta">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}

      <button type="button" class="site-header__cart-btn" data-cart-open aria-label="Cart">
        {% render 'icon-cart' %}
        <span class="site-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

{%- comment -%}
  Sticky buy bar: hidden until the shopper scrolls past the hero, then pinned to
  the bottom on mobile / top on desktop. Single-product stores live and die on
  always-having-a-buy-button, so this is the only nav element on the page.
{%- endcomment -%}
{%- if settings.show_sticky_buy -%}
  <div class="sticky-buy" data-sticky-buy hidden>
    <div class="sticky-buy__inner page-width">
      <div class="sticky-buy__info">
        <span class="sticky-buy__name">{{ section.settings.sticky_product_name }}</span>
        {%- if section.settings.sticky_price != blank -%}
          <span class="sticky-buy__price">{{ section.settings.sticky_price }}</span>
        {%- endif -%}
      </div>
      <a href="{{ section.settings.cta_link | default: '#offer' }}" class="button button--primary sticky-buy__button">
        {{ section.settings.cta_label }}
      </a>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "paragraph",
      "content": "This is a single-product store, so the header has no nav links on purpose. Every link is an exit ramp away from the buy button."
    },
    {
      "type": "checkbox",
      "id": "show_header_cta",
      "label": "Show buy button in header",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Buy button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Buy button link",
      "info": "Leave empty to scroll to the pricing section on the home page."
    },
    {
      "type": "header",
      "content": "Sticky buy bar"
    },
    {
      "type": "text",
      "id": "sticky_product_name",
      "label": "Product name",
      "default": "The Stud Kit — 3 sizes"
    },
    {
      "type": "text",
      "id": "sticky_price",
      "label": "Price text",
      "default": "$39"
    }
  ]
}
{% endschema %}
