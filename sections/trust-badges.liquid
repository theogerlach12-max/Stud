<section class="trust-badges page-width">
  {%- for block in section.blocks -%}
    <div class="trust-badge" {{ block.shopify_attributes }}>
      <span class="trust-badge__icon">
        {%- case block.settings.icon -%}
          {%- when 'magnet' -%}{% render 'icon-magnet' %}
          {%- when 'shield' -%}{% render 'icon-shield' %}
          {%- when 'truck' -%}{% render 'icon-truck' %}
          {%- when 'gift' -%}{% render 'icon-gift' %}
        {%- endcase -%}
      </span>
      <h3 class="trust-badge__title">{{ block.settings.title }}</h3>
      <p class="trust-badge__text">{{ block.settings.text }}</p>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Trust badges",
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "magnet", "label": "Magnet" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "magnet"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "No piercing needed"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Strong magnetic hold that looks just like the real thing."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "magnet", "title": "No piercing needed", "text": "Strong magnetic hold that looks just like the real thing." } },
        { "type": "badge", "settings": { "icon": "shield", "title": "Hypoallergenic", "text": "Nickel-free finishes safe for sensitive ears." } },
        { "type": "badge", "settings": { "icon": "truck", "title": "Free shipping", "text": "On every order, no minimum." } },
        { "type": "badge", "settings": { "icon": "gift", "title": "30-day guarantee", "text": "Not in love with it? Full refund, no questions." } }
      ]
    }
  ]
}
{% endschema %}
