<section class="landing-section landing-section--invert stay-on" id="stay-on">
  <div class="page-width">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="display display--md">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}
        <p class="section-head__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <div class="stay-on__media">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video
          | video_tag:
            image_size: '1600x',
            autoplay: section.settings.autoplay,
            loop: section.settings.loop,
            muted: true,
            controls: true,
            playsinline: true
        }}
      {%- elsif section.settings.video_url != blank -%}
        <div class="stay-on__embed">
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?playsinline=1&rel=0"
              title="{{ section.settings.heading | escape }}"
              allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          {%- else -%}
            <iframe
              src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}"
              title="{{ section.settings.heading | escape }}"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          {%- endif -%}
        </div>
      {%- elsif section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1800 }}"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="stay-on__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.caption != blank -%}
      <p class="stay-on__caption">{{ section.settings.caption }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="stay-on__proof">
        {%- for block in section.blocks -%}
          <li class="stay-on__proof-item" {{ block.shopify_attributes }}>
            <span class="stay-on__proof-stat display display--xs">{{ block.settings.stat }}</span>
            <span class="stay-on__proof-label">{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Stay-on proof",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "This is the section that sells the product. Put real footage here: a full practice, a game, a lift. Uncut is more convincing than edited."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The stay-on test"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "To be the best you need to feel like it."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Confidence is not a small thing. It is also useless if you spend the whole game checking your ear. So we tested it the only way that counts."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (uploaded to Shopify)"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL (YouTube or Vimeo)",
      "accept": ["youtube", "vimeo"],
      "info": "Used only if no uploaded video is set."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image",
      "info": "Shown if there is no video yet."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay uploaded video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop uploaded video",
      "default": true
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Full practice, no tape, no adjustments."
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Proof point",
      "settings": [
        { "type": "text", "id": "stat", "label": "Stat", "default": "0" },
        { "type": "text", "id": "label", "label": "Label", "default": "times it came off" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stay-on proof",
      "blocks": [
        { "type": "proof", "settings": { "stat": "Contact", "label": "Tested through contact, not a photoshoot" } },
        { "type": "proof", "settings": { "stat": "Sweat", "label": "Grip holds when your ear doesn't stay dry" } },
        { "type": "proof", "settings": { "stat": "Helmets", "label": "Sits flat enough for headgear to go over it" } }
      ]
    }
  ]
}
{% endschema %}
