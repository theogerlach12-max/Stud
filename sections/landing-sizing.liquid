<section class="landing-section sizing{% if section.settings.invert %} landing-section--invert{% endif %}" id="sizing">
  <div class="page-width">
    <div class="section-head section-head--center" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="display display--md">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}
        <p class="section-head__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    {%- assign sizes = section.blocks | where: 'type', 'size' -%}

    {%- if sizes.size > 0 -%}
      <div class="sizing__grid">
        {%- for block in sizes -%}
          <div class="size-card" data-reveal {{ block.shopify_attributes }}>
            <div class="size-card__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- elsif block.settings.image_asset != blank -%}
                <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <p class="size-card__size">{{ block.settings.size }}</p>
            <h3 class="size-card__name">{{ block.settings.name }}</h3>
            <p class="size-card__text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="sizing__cta" data-reveal>
        <a href="{{ section.settings.button_link | default: '#signup' }}" class="button {% if section.settings.invert %}button--invert{% else %}button--primary{% endif %} button--large">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sizing kit",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "invert",
      "label": "Black background",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The kit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your fit in 10 seconds."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Every kit ships with all three sizes. Put each one on, look in the mirror, keep the one that looks like it was made for your face. No measuring, no guessing, no exchange."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Save 10%"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Bundled image filename", "info": "A file in assets/. Used when no image is picked above." },
        { "type": "text", "id": "image_alt", "label": "Bundled image alt text" },
        { "type": "text", "id": "size", "label": "Size", "default": "4mm" },
        { "type": "text", "id": "name", "label": "Name", "default": "Clean" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Subtle. Reads as jewelry, not a statement." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sizing kit",
      "blocks": [
        {
          "type": "size",
          "settings": { "size": "4mm", "name": "Clean", "text": "Subtle. Reads as jewelry, not a statement. The safe first pick." }
        },
        {
          "type": "size",
          "settings": { "size": "5mm", "name": "Standard", "text": "The one most guys land on. Visible from across the court, not from space." }
        },
        {
          "type": "size",
          "settings": { "size": "6mm", "name": "Loud", "text": "You want people to notice. They will." }
        }
      ]
    }
  ]
}
{% endschema %}
