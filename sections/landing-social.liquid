{%- liquid
  assign photos = section.blocks | where: 'type', 'photo'
  assign quotes = section.blocks | where: 'type', 'quote'
-%}

<section class="landing-section social">
  <div class="page-width">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="display display--md">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}
        <p class="section-head__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- if photos.size > 0 -%}
    <div class="carousel" data-carousel>
      <button type="button" class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label="Previous">
        {% render 'icon-chevron' %}
      </button>

      <ul class="carousel__track" data-carousel-track>
        {%- for block in photos -%}
          <li class="carousel__item" {{ block.shopify_attributes }}>
            <figure class="carousel__figure">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                >
              {%- elsif block.settings.image_asset != blank -%}
                <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy">
              {%- else -%}
                <div class="carousel__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <figcaption class="carousel__caption">{{ block.settings.caption }}</figcaption>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>

      <button type="button" class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label="Next">
        {% render 'icon-chevron' %}
      </button>
    </div>
  {%- endif -%}

  {%- if section.settings.button_label != blank -%}
    <div class="social__cta page-width">
      <a href="{{ section.settings.button_link | default: '#signup' }}" class="button button--primary button--large">
        {{ section.settings.button_label }}
      </a>
    </div>
  {%- endif -%}

  {%- if quotes.size > 0 -%}
    <div class="page-width">
      <div class="social__quotes">
        {%- for block in quotes -%}
          {%- if block.settings.quote != blank -%}
            <blockquote class="quote-card" {{ block.shopify_attributes }}>
              <p class="quote-card__text">{{ block.settings.quote }}</p>
              <footer class="quote-card__by">
                {{ block.settings.name }}
                {%- if block.settings.detail != blank -%}
                  <span>{{ block.settings.detail }}</span>
                {%- endif -%}
              </footer>
            </blockquote>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Photo carousel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In the wild" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why do something permanent when you don't have to?"
    },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Save 10%" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Bundled image filename", "info": "A file in assets/. Used when no image is picked above." },
        { "type": "text", "id": "image_alt", "label": "Bundled image alt text" },
        { "type": "text", "id": "caption", "label": "Caption or handle" }
      ]
    },
    {
      "type": "quote",
      "name": "Customer quote",
      "settings": [
        {
          "type": "paragraph",
          "content": "Only add quotes you actually received. Leave the quote field empty and the block will not render."
        },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "detail", "label": "Detail (sport, school, city)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Photo carousel",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
