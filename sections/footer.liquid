<footer class="site-footer">
  {%- if section.settings.show_newsletter -%}
    <div class="site-footer__newsletter" id="signup">
      <div class="page-width site-footer__newsletter-inner">
        <div>
          <h3 class="display display--xs">{{ section.settings.newsletter_heading }}</h3>
          <p>{{ section.settings.newsletter_subtext }}</p>
        </div>
        {% form 'customer' %}
          {%- if form.posted_successfully? -%}
            <p class="form-success">Thanks — you're on the list.</p>
          {%- endif -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="site-footer__newsletter-form">
            <input type="email" name="contact[email]" placeholder="Email address" required aria-label="Email address">
            <button type="submit" class="button button--invert">Get my 10%</button>
          </div>
        {% endform %}
      </div>
    </div>
  {%- endif -%}

  <div class="page-width site-footer__main">
    <div class="site-footer__brand">
      {%- comment -%} logo-mark--invert flips the black artwork to white for the dark footer. {%- endcomment -%}
      {%- if settings.logo != blank -%}
        <img class="logo-mark logo-mark--invert" src="{{ settings.logo | image_url: width: 500 }}" alt="{{ shop.name }}" loading="lazy" style="width: {{ settings.logo_width }}px;">
      {%- elsif settings.logo_asset != blank -%}
        <img class="logo-mark logo-mark--invert" src="{{ settings.logo_asset | asset_url }}" alt="{{ shop.name }}" loading="lazy" style="width: {{ settings.logo_width }}px;">
      {%- else -%}
        <span class="wordmark wordmark--footer">{{ settings.wordmark | default: shop.name }}</span>
      {%- endif -%}
      <p class="site-footer__blurb">{{ section.settings.brand_text }}</p>
    </div>

    <div class="site-footer__links">
      {%- if section.settings.menu != blank -%}
        <ul>
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="site-footer__social">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}">Instagram</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}">TikTok</a>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}">YouTube</a>{%- endif -%}
      </div>
    </div>
  </div>

  <div class="page-width site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    <div class="site-footer__payment-icons">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'payment-icon' }}
      {%- endfor -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Save 10% on launch day"
    },
    {
      "type": "text",
      "id": "newsletter_subtext",
      "label": "Newsletter subtext",
      "default": "Drop your email. We'll send your code the day we open."
    },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand blurb",
      "default": "Magnetic diamond studs built for people who play. No piercing, no downtime, no excuses."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu",
      "default": "footer",
      "info": "Keep this to policies and contact. Every other link is a way off the page."
    }
  ]
}
{% endschema %}
