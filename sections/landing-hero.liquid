{%- liquid
  assign product = section.settings.product
  assign price_text = section.settings.price_text
  if product != blank and section.settings.use_product_price
    assign price_text = product.price | money
  endif
-%}

<section class="hero-single" data-hero>
  <div class="hero-single__media">
    {%- if section.settings.image != blank -%}
      <img
        class="hero-single__image hero-single__image--desktop"
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w,
                {{ section.settings.image | image_url: width: 1400 }} 1400w,
                {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <div class="hero-single__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}

    {%- if section.settings.image_mobile != blank -%}
      <img
        class="hero-single__image hero-single__image--mobile"
        src="{{ section.settings.image_mobile | image_url: width: 1200 }}"
        alt="{{ section.settings.image_mobile.alt | escape }}"
        loading="eager"
      >
    {%- endif -%}

    <div class="hero-single__scrim"></div>
  </div>

  <div class="hero-single__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow hero-single__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="hero-single__heading display">{{ section.settings.heading }}</h1>

    {%- if section.settings.subheading != blank -%}
      <p class="hero-single__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="hero-single__actions">
      {%- comment -%} Inverted: a black button disappears against the dark hero scrim. {%- endcomment -%}
      <a href="{{ section.settings.button_link | default: '#offer' }}" class="button button--invert button--large">
        {{ section.settings.button_label }}
      </a>
      {%- if price_text != blank -%}
        <span class="hero-single__price">
          {{ price_text }}
          {%- if section.settings.price_note != blank -%}
            <span class="hero-single__price-note">{{ section.settings.price_note }}</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="hero-single__bullets">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Product shot on an athlete. Shoot it with headroom on the left so the headline has somewhere to sit."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (mobile, optional)",
      "info": "A tighter crop for portrait screens. Falls back to the desktop image."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Magnetic. No piercing."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Look good. Feel good. Play good."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheadline",
      "default": "A real-looking diamond stud that clamps on in two seconds, holds through contact, and comes off when you want it to. No holes, no healing, no eligibility problems."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get your kit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to scroll to the pricing section."
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "use_product_price",
      "label": "Use the live Shopify price",
      "default": true,
      "info": "Off (or no product selected) falls back to the text below, so the page reads correctly before the product exists."
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Price text (fallback)",
      "default": "$39"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Price note",
      "default": "3 sizes included · free shipping"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "No piercing needed"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "bullet", "settings": { "text": "No piercing needed" } },
        { "type": "bullet", "settings": { "text": "3 sizes in every kit" } },
        { "type": "bullet", "settings": { "text": "Built to stay on" } }
      ]
    }
  ]
}
{% endschema %}
