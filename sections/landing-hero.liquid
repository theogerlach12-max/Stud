{%- comment -%}
  Full-bleed hero: the photograph covers the section, copy sits over it.

  The CTA is meant to point at a dedicated email landing page. There is no
  on-page signup any more, so "Button link" needs a real URL — left empty it
  renders as an inert anchor.
{%- endcomment -%}

<section class="hero-full" data-hero>
  <div class="hero-full__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w,
                {{ section.settings.image | image_url: width: 1600 }} 1600w,
                {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- elsif section.settings.image_asset != blank -%}
      <img
        src="{{ section.settings.image_asset | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <div class="hero-full__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
    <div class="hero-full__scrim"></div>
  </div>

  <div class="hero-full__content page-width">
    <div class="hero-full__inner" data-reveal>
      <h1 class="hero-full__heading display display--hero">{{ section.settings.heading }}</h1>

      {%- if section.settings.review_count != blank -%}
        <div class="rating hero-full__rating">
          <span class="rating__stars" role="img" aria-label="{{ section.settings.rating | default: 5 }} out of 5 stars">
            {%- for i in (1..5) -%}
              {% render 'icon-star', filled: true %}
            {%- endfor -%}
          </span>
          <span class="rating__count">{{ section.settings.review_count }}</span>
        </div>
      {%- elsif request.design_mode -%}
        <p class="editor-note">
          Editor note: the star rating renders here as soon as "Review count" is
          filled in. It is empty because the store has no reviews yet.
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--invert button--large hero-full__cta">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="hero-full__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Look good, feel good, play good."
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "info": "Example: \"15,000 reviews\". Leave empty until the number is real — the stars do not render without it.",
      "default": ""
    },
    {
      "type": "range",
      "id": "rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Stars shown",
      "default": 5
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Save 10%"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Point this at your email landing page. There is no signup form on this page any more, so an empty link goes nowhere."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the button",
      "default": ""
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Bundled image filename",
      "default": "hero-rolls.png",
      "info": "A file in assets/. Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Bundled image alt text",
      "default": "Man stepping out of a black Rolls-Royce at night"
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
