{%- comment -%}
  Split hero: copy on the left, photograph on the right.
  The CTA points at the email capture rather than a cart — there is no
  purchasable product yet, so the whole page funnels to the 10% signup.
{%- endcomment -%}

<section class="hero-split{% unless section.settings.light %} hero-split--dark{% endunless %}" data-hero>
  <div class="hero-split__content">
    <div class="hero-split__inner" data-reveal>
      <h1 class="hero-split__heading display">{{ section.settings.heading }}</h1>

      {%- if section.settings.review_count != blank -%}
        <div class="rating hero-split__rating">
          <span class="rating__stars" role="img" aria-label="{{ section.settings.rating | default: 5 }} out of 5 stars">
            {%- for i in (1..5) -%}
              {% render 'icon-star', filled: true %}
            {%- endfor -%}
          </span>
          <span class="rating__count">{{ section.settings.review_count }}</span>
        </div>
      {%- elsif request.design_mode -%}
        <p class="editor-note">
          Editor note: the star rating renders here as soon as "Review count" is
          filled in. It is empty because the store has no reviews yet.
        </p>
      {%- endif -%}

      <a href="{{ section.settings.button_link | default: '#signup' }}" class="button {% if section.settings.light %}button--primary{% else %}button--invert{% endif %} button--large hero-split__cta">
        {{ section.settings.button_label }}
      </a>

      {%- if section.settings.note != blank -%}
        <p class="hero-split__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="hero-split__media" data-reveal>
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w,
                {{ section.settings.image | image_url: width: 1600 }} 1600w"
        sizes="(min-width: 750px) 50vw, 100vw"
        alt="{{ section.settings.image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- elsif section.settings.image_asset != blank -%}
      <img
        src="{{ section.settings.image_asset | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "light",
      "label": "White background",
      "default": false,
      "info": "Off means a black hero with white type."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Look good, feel good, play good."
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "info": "Example: \"15,000 reviews\". Leave empty until the number is real — the stars do not render without it.",
      "default": ""
    },
    {
      "type": "range",
      "id": "rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Stars shown",
      "default": 5
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Save 10%"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to scroll to the email signup at the bottom of the page. Point it at a dedicated landing page once you have one."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note under the button",
      "default": "Enter your email, get 10% off launch day."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Bundled image filename",
      "default": "hero-porsche.png",
      "info": "A file in assets/. Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Bundled image alt text",
      "default": "Man in a suit lying across the hood of a Porsche at night"
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
