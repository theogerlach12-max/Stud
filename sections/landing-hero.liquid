{%- comment -%}
  Stripped hero: image, headline, rating. Nothing else by design.
  The buy button lives in the header and in the sticky buy bar that appears the
  moment this section scrolls away, so the page is never without one.

  Image resolution: image_picker (Shopify Files) wins, then a file bundled in
  assets/ via image_asset, then a placeholder. The bundled fallback is what
  makes the theme look finished before a store exists.
{%- endcomment -%}

<section class="hero-single" data-hero>
  <div class="hero-single__media">
    {%- if section.settings.image != blank -%}
      <img
        class="hero-single__image hero-single__image--desktop"
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w,
                {{ section.settings.image | image_url: width: 1400 }} 1400w,
                {{ section.settings.image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- elsif section.settings.image_asset != blank -%}
      <img
        class="hero-single__image hero-single__image--desktop"
        src="{{ section.settings.image_asset | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <div class="hero-single__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}

    {%- if section.settings.image_mobile != blank -%}
      <img
        class="hero-single__image hero-single__image--mobile"
        src="{{ section.settings.image_mobile | image_url: width: 1200 }}"
        alt="{{ section.settings.image_mobile.alt | escape }}"
        loading="eager"
      >
    {%- endif -%}

    {%- if section.settings.show_grain -%}
      <div class="hero-single__grain" aria-hidden="true"></div>
    {%- endif -%}
    <div class="hero-single__scrim"></div>
  </div>

  <div class="hero-single__content page-width">
    <div class="hero-single__lockup">
      <h1 class="hero-single__heading display">{{ section.settings.heading }}</h1>

      {%- if section.settings.review_count != blank -%}
        <div class="rating hero-single__rating">
          <span class="rating__stars" role="img" aria-label="{{ section.settings.rating | default: 5 }} out of 5 stars">
            {%- for i in (1..5) -%}
              {% render 'icon-star', filled: true %}
            {%- endfor -%}
          </span>
          <span class="rating__count">{{ section.settings.review_count }}</span>
        </div>
      {%- elsif request.design_mode -%}
        <p class="editor-note editor-note--hero">
          Editor note: the star rating renders here as soon as you fill in
          "Review count" in this section's settings. It is empty because the
          store has no reviews yet — publishing a review count you don't have is
          what the FTC's fake-review rule is about, and it is the single easiest
          thing for a competitor to report. Put the real number in the moment
          you have one.
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Overrides the bundled image below once you upload one to Shopify."
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Bundled image filename",
      "default": "hero-porsche.png",
      "info": "A file in the theme's assets/ folder. Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Bundled image alt text",
      "default": "Man in a suit lying across the hood of a Porsche at night"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (mobile, optional)"
    },
    {
      "type": "checkbox",
      "id": "show_grain",
      "label": "Film grain overlay",
      "default": true,
      "info": "Adds photographic grain. Also hides softness when the source image is small."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Look good, feel good, play good."
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "info": "Example: \"15,000 reviews\". Leave empty until the number is real — the stars do not render without it.",
      "default": ""
    },
    {
      "type": "range",
      "id": "rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Stars shown",
      "default": 5
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
