{%- liquid
  assign product = section.settings.product
  assign has_product = false
  if product != blank and product.available
    assign has_product = true
  endif
  assign included = section.blocks | where: 'type', 'included'
  assign tiers = section.blocks | where: 'type', 'tier'
-%}

<section class="landing-section offer" id="offer">
  <div class="page-width">
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="display display--md">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}
        <p class="section-head__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <div class="offer__layout">

      {%- comment -%} What's in the box {%- endcomment -%}
      <div class="box">
        <div class="box__media">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              alt="{{ section.settings.image.alt | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="box__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
        </div>

        {%- if included.size > 0 -%}
          <h3 class="box__title">{{ section.settings.box_title }}</h3>
          <ul class="box__list">
            {%- for block in included -%}
              <li class="box__item" {{ block.shopify_attributes }}>
                <span class="box__item-title">{{ block.settings.title }}</span>
                {%- if block.settings.text != blank -%}
                  <span class="box__item-text">{{ block.settings.text }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Pricing tiers {%- endcomment -%}
      <div class="tiers">
        {%- for block in tiers -%}
          {%- liquid
            comment
              A tier can point at its own product. That is how you run a real
              bundle: make a 2-pack product with its own price and select it
              here. Left empty, the tier just adds N of the main product, which
              is N x the unit price and therefore not a discount.
            endcomment
            assign tier_product = block.settings.product
            if tier_product == blank
              assign tier_product = product
            endif
            assign has_tier_product = false
            if tier_product != blank and tier_product.available
              assign has_tier_product = true
            endif

            assign qty = block.settings.quantity | at_least: 1
            assign total = block.settings.price_text
            assign compare = block.settings.compare_text
            assign unit = ''
            if has_tier_product
              assign total = tier_product.price | times: qty | money
              assign unit = tier_product.price | money
              if tier_product.compare_at_price > tier_product.price
                assign compare = tier_product.compare_at_price | times: qty | money
              else
                assign compare = ''
              endif
            endif
          -%}
          <div class="tier{% if block.settings.featured %} tier--featured{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.badge != blank -%}
              <span class="tier__badge">{{ block.settings.badge }}</span>
            {%- endif -%}

            <h3 class="tier__name">{{ block.settings.label }}</h3>
            {%- if block.settings.sublabel != blank -%}
              <p class="tier__sublabel">{{ block.settings.sublabel }}</p>
            {%- endif -%}

            <p class="tier__price display display--xs">
              {%- if compare != blank -%}
                <s class="tier__compare">{{ compare }}</s>
              {%- endif -%}
              {{ total }}
            </p>

            {%- if unit != blank and qty > 1 -%}
              <p class="tier__unit">{{ unit }} per kit</p>
            {%- endif -%}

            {%- if block.settings.note != blank -%}
              <p class="tier__note">{{ block.settings.note }}</p>
            {%- endif -%}

            {%- if has_tier_product -%}
              <form data-quick-add-form>
                {%- if tier_product.variants.size > 1 -%}
                  <label class="visually-hidden" for="TierVariant-{{ block.id }}">Options</label>
                  <select class="tier__variant" id="TierVariant-{{ block.id }}" name="id">
                    {%- for variant in tier_product.variants -%}
                      <option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>
                        {{ variant.title }}
                      </option>
                    {%- endfor -%}
                  </select>
                {%- else -%}
                  <input type="hidden" name="id" value="{{ tier_product.selected_or_first_available_variant.id }}">
                {%- endif -%}
                <input type="hidden" name="quantity" value="{{ qty }}">
                <button type="submit" class="button button--primary button--block{% unless block.settings.featured %} button--outline{% endunless %}">
                  {{ block.settings.button_label | default: 'Add to cart' }}
                </button>
              </form>
            {%- else -%}
              <a href="{{ section.settings.fallback_link | default: routes.all_products_collection_url }}" class="button button--primary button--block{% unless block.settings.featured %} button--outline{% endunless %}">
                {{ block.settings.button_label | default: 'Add to cart' }}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if section.settings.reassurance != blank -%}
          <p class="tiers__reassurance">{{ section.settings.reassurance }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if request.design_mode and has_product == false -%}
      <p class="editor-note">
        Editor note: no purchasable product is connected, so these buttons link
        out instead of adding to cart. Pick the product under this section's
        settings once it exists in Shopify — prices then come from Shopify
        automatically and the fallback price text is ignored.
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pricing & what's in the box",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Connect the product and every price here comes from Shopify. Until then the fallback text below is used."
    },
    {
      "type": "url",
      "id": "fallback_link",
      "label": "Fallback button link",
      "info": "Used only while no product is connected."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One kit. Every size. One price."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "No subscriptions, no size roulette, nothing to send back."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Box / product image"
    },
    {
      "type": "text",
      "id": "box_title",
      "label": "What's in the box title",
      "default": "What's in the box"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Reassurance line",
      "default": "Free shipping · 30-day returns · Secure checkout"
    }
  ],
  "blocks": [
    {
      "type": "included",
      "name": "In the box",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "3 studs" },
        { "type": "text", "id": "text", "label": "Text", "default": "4mm, 5mm and 6mm" }
      ]
    },
    {
      "type": "tier",
      "name": "Pricing tier",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product for this tier (optional)",
          "info": "Leave empty to add the section's product. To give a bundle a real discount, create a 2-pack product priced below 2x and select it here — otherwise a quantity tier is just N times the unit price."
        },
        { "type": "text", "id": "label", "label": "Label", "default": "1 kit" },
        { "type": "text", "id": "sublabel", "label": "Sublabel", "default": "Try it" },
        {
          "type": "number",
          "id": "quantity",
          "label": "Quantity added to cart",
          "default": 1
        },
        { "type": "text", "id": "price_text", "label": "Price text (fallback)", "default": "$39" },
        { "type": "text", "id": "compare_text", "label": "Compare-at text (fallback)" },
        { "type": "text", "id": "note", "label": "Note" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "checkbox", "id": "featured", "label": "Highlight this tier", "default": false },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pricing & what's in the box",
      "blocks": [
        { "type": "included", "settings": { "title": "3 studs", "text": "4mm, 5mm and 6mm, so your size is already in the box" } },
        { "type": "included", "settings": { "title": "3 magnetic backs", "text": "Matched to each front" } },
        { "type": "included", "settings": { "title": "Hard-shell case", "text": "Small enough to live in a gym bag" } },
        { "type": "included", "settings": { "title": "Microfiber cloth", "text": "For the days it stops looking new" } },
        {
          "type": "tier",
          "settings": {
            "label": "1 kit",
            "sublabel": "For you",
            "quantity": 1,
            "price_text": "$39",
            "button_label": "Add to cart"
          }
        },
        {
          "type": "tier",
          "settings": {
            "label": "2 kits",
            "sublabel": "One for a teammate",
            "quantity": 2,
            "price_text": "$78",
            "badge": "Most popular",
            "featured": true,
            "note": "The one everybody actually buys — you will lose one eventually.",
            "button_label": "Add to cart"
          }
        },
        {
          "type": "tier",
          "settings": {
            "label": "3 kits",
            "sublabel": "Team pack",
            "quantity": 3,
            "price_text": "$117",
            "button_label": "Add to cart"
          }
        }
      ]
    }
  ]
}
{% endschema %}
