<section class="landing-section landing-section--invert problem">
  <div class="page-width">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="display display--md">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}
        <p class="section-head__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <ol class="problem__list">
      {%- for block in section.blocks -%}
        <li class="problem__item" {{ block.shopify_attributes }}>
          <span class="problem__num">{{ forloop.index }}</span>
          <h3 class="problem__title">{{ block.settings.title }}</h3>
          <p class="problem__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.closer != blank -%}
      <p class="problem__closer display display--sm">{{ section.settings.closer }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Problem",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why this exists"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Piercings and sports don't mix."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Every athlete who has wanted a stud has run into the same three walls."
    },
    {
      "type": "text",
      "id": "closer",
      "label": "Closing line",
      "default": "So we built one that doesn't need a hole."
    }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "The rulebook" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Most leagues make you take jewelry out to play. Tape it, lose it, or sit." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problem",
      "blocks": [
        {
          "type": "problem",
          "settings": {
            "title": "The rulebook",
            "text": "Most leagues won't let you play in pierced jewelry. Tape over it, take it out, or sit out."
          }
        },
        {
          "type": "problem",
          "settings": {
            "title": "The healing",
            "text": "A fresh piercing wants weeks of downtime and no contact. Nobody is giving up a season for an earring."
          }
        },
        {
          "type": "problem",
          "settings": {
            "title": "The one you lose",
            "text": "Backs work loose. Helmets and headgear rip them out. You find one stud in the gym bag and never the other."
          }
        }
      ]
    }
  ]
}
{% endschema %}
