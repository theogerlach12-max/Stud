{%- comment -%}
  Bridges two sections of different colours.

  "gradient" is a short static band that simply fades one background into the
  next.

  "scroll" is a tall pinned stage driven by scroll position: black at the top,
  the clip fading in, then white rising from the bottom edge until it covers the
  lower half of the screen — at which point the pin releases and the next
  (white) section carries on from exactly that line. theme.js writes the two
  custom properties; with JS off the stage falls back to the plain gradient.

  Shopify's assets/ folder does not reliably accept video, so the primary source
  is a video uploaded through the theme editor. "Bundled video filename" is a
  fallback for anyone who does get an asset upload to stick.
{%- endcomment -%}

{%- liquid
  assign has_video = false
  if section.settings.video != blank or section.settings.video_asset != blank
    assign has_video = true
  endif
-%}

{%- if section.settings.mode == 'scroll' -%}

  <div
    class="tone-stage tone-stage--{{ section.settings.direction }}{% if section.settings.desaturate %} tone-stage--desaturate{% endif %}"
    style="--stage-height: {{ section.settings.scroll_length }}vh; --stage-white-stop: {{ section.settings.white_stop }}vh;"
    data-tone-stage
  >
    <div class="tone-stage__pin">
      {%- if has_video -%}
        <div class="tone-stage__video" aria-hidden="true">
          {%- if section.settings.video != blank -%}
            {{ section.settings.video
              | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true
            }}
          {%- else -%}
            <video
              src="{{ section.settings.video_asset | asset_url }}"
              autoplay
              loop
              muted
              playsinline
              data-tone-video
              data-playback-rate="{{ section.settings.playback_rate }}"
            ></video>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="tone-stage__rise" aria-hidden="true"></div>
    </div>
  </div>

{%- else -%}

  <div
    class="tone-shift tone-shift--{{ section.settings.direction }}{% if has_video %} tone-shift--has-video{% endif %}{% if section.settings.desaturate %} tone-shift--desaturate{% endif %}"
    style="--tone-shift-height: {{ section.settings.height }}vh;"
    data-reveal
  >
    {%- if has_video -%}
      <div class="tone-shift__media" aria-hidden="true">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video
            | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true
          }}
        {%- else -%}
          <video
            src="{{ section.settings.video_asset | asset_url }}"
            autoplay
            loop
            muted
            playsinline
            data-tone-video
            data-playback-rate="{{ section.settings.playback_rate }}"
          ></video>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="tone-shift__gradient" aria-hidden="true"></div>
  </div>

{%- endif -%}

{% schema %}
{
  "name": "Tone transition",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Mode",
      "options": [
        { "value": "gradient", "label": "Gradient band (short)" },
        { "value": "scroll", "label": "Scroll stage (pinned, scroll-driven)" }
      ],
      "default": "gradient"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Fades",
      "options": [
        { "value": "to-white", "label": "Black into white" },
        { "value": "to-black", "label": "White into black" }
      ],
      "default": "to-white"
    },
    {
      "type": "header",
      "content": "Gradient band"
    },
    {
      "type": "range",
      "id": "height",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "vh",
      "label": "Height",
      "default": 30
    },
    {
      "type": "header",
      "content": "Scroll stage"
    },
    {
      "type": "range",
      "id": "scroll_length",
      "min": 150,
      "max": 400,
      "step": 10,
      "unit": "vh",
      "label": "Scroll length",
      "default": 260,
      "info": "How far the shopper scrolls while the stage is pinned. Longer is slower."
    },
    {
      "type": "range",
      "id": "white_stop",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "White rises to",
      "default": 50,
      "info": "How far up the screen the white reaches before the next section takes over."
    },
    {
      "type": "header",
      "content": "Background video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Upload the clip in Shopify (Content → Files or this picker). Plays muted and looped."
    },
    {
      "type": "text",
      "id": "video_asset",
      "label": "Bundled video filename",
      "info": "A file in assets/, used only if no video is picked above. Shopify often rejects video uploads to assets/, so the picker is the reliable route."
    },
    {
      "type": "checkbox",
      "id": "desaturate",
      "label": "Desaturate the video",
      "default": true,
      "info": "Strips colour so the footage matches the black, white and silver palette."
    },
    {
      "type": "range",
      "id": "playback_rate",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "label": "Playback speed",
      "default": 0.4,
      "info": "Short clips loop very fast at full speed. Applies to bundled video only."
    }
  ],
  "presets": [
    { "name": "Tone transition" }
  ]
}
{% endschema %}
